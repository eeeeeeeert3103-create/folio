# Скопируйте в .env.local и заполните значениями из Supabase:
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Необязательно: публичный адрес сайта для ссылок на портфолио и входа.
# Для Vercel можно указать постоянный production-домен.
# FOLIO_SITE_URL=https://folio-mu-jet.vercel.app

# Необязательно: капча Cloudflare Turnstile на входе по почте.
# Ключ сайта из Cloudflare → Turnstile. Секретный ключ вставьте в Supabase:
# Authentication → Attack Protection → Enable Captcha protection → Turnstile.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
